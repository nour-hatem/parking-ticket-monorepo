# ─────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env — it contains real secrets.
# ─────────────────────────────────────────────────

# Security (ArcJet) — https://arcjet.com
ARCJET_ENV=development
ARCJET_KEY=your_arcjet_key_here
ARCJET_MODE=DRY_RUN          # DRY_RUN | LIVE

# Database Configuration (PostgreSQL 16)
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=parking
DATABASE_PASSWORD=parking123
DATABASE_NAME=parking_db

# Prisma Database Connection String (Local Docker or Prisma Cloud)
DATABASE_URL="postgresql://parking:parking123@localhost:5433/parking_db?schema=public"

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d
